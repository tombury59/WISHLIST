# Copie ce fichier en ".env.local" pour tester en local.
# Le code PIN partagé de la famille :
FAMILY_PIN=1234

# Les 2 variables ci-dessous sont ajoutées AUTOMATIQUEMENT par Vercel
# quand tu connectes une base "Upstash" (voir le README). En local tu peux
# les copier depuis l'onglet Storage de ton projet Vercel.
# (Selon les cas elles s'appellent KV_... ou UPSTASH_..., les deux marchent.)
# KV_REST_API_URL=...
# KV_REST_API_TOKEN=...
